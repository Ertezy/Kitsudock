{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitsudock",
  "version": "0.1.4",
  "identifier": "io.github.ertezy.kitsudock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kitsudock",
        "width": 1150,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ws: wss:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/images/*", "$APPCACHE/icons/*", "$APPCACHE/art/*", "$APPCACHE/launcher-art/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Ertezy",
    "copyright": "© 2026 Ertezy",
    "resources": ["resources/hub.json"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": ["nsis"],
    "homepage": "https://github.com/Ertezy/Kitsudock",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNUY1M0M1MEY0NUQ4MjkKUldRcDJFVVB4Vk5mZ3RxODc3eXlHM25ORHFIdXZEUlY0UldNaDRZR3B3QnV4Skk3aXFZL0dBWksK",
      "endpoints": ["https://github.com/Ertezy/Kitsudock/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
